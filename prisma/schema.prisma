generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// --- App models ---

model Coach {
  id          String   @id @default(cuid())
  name        String   @unique
  level       String? // free-text CrossFit level, e.g. "CF-L1"
  // Standard weekly quota of group classes, used on the Dashboard whenever
  // that week has no explicit CoachWeeklyQuota override — lets the admin
  // set it once instead of every week. A week-specific override in
  // CoachWeeklyQuota always wins over this.
  weeklyQuota Int?
  // € paid per validated group class this coach delivers (see
  // computeCoachStats). Null falls back to the CrossFit-level default (see
  // groupClassRate) — set once the admin edits it on the Coaches page, at
  // which point it's a plain per-coach number and no longer follows level
  // changes automatically.
  rate        Int?
  // Hex color (e.g. "#3b82f6") tinting this coach's classes on the admin
  // Planning grid, so the head coach can see who's teaching what at a
  // glance — see WeekGrid. Null falls back to the room-based tint. Unique
  // (Postgres allows unlimited NULLs alongside a unique constraint, so this
  // only actually restricts non-null values) so two coaches never end up
  // sharing a color — see renameCoach's takenColors check, which is the
  // primary guard; this is the backstop against a race between two saves.
  color       String?  @unique
  // Login credential for /upload — the coach's unique `name` doubles as
  // their username. Null until the admin sets one (see setCoachPassword on
  // the Coaches page); a coach with no password set can't log in yet.
  // Replaces the old unguessable-link (accessToken) system now that /upload
  // is gated by real auth (see middleware.ts).
  passwordHash String?
  // Set when the admin marks this coach's private-class debt as settled
  // (see markPrivateBalancePaid) — only private classes delivered after
  // this date count toward the outstanding balance shown on the Coaches
  // page (see computePrivateBalance). Null means nothing has ever been
  // paid, so the whole history counts.
  privateBalancePaidAt DateTime?
  // Soft-delete: set once a coach no longer works at the box. Keeps their
  // history (past classes, submissions, stats) intact while cutting off
  // their private upload access (see /upload/[token] and the coach-active
  // guard in lib/actions/submissions.ts) — reversible via unarchiveCoach,
  // unlike Remove which permanently deletes the row.
  archived    Boolean  @default(false)
  createdAt   DateTime @default(now())

  classInstances    ClassInstance[]    @relation("PrimaryCoach")
  substituteClasses ClassInstance[]    @relation("SubstituteCoach")
  templates         ClassTemplate[]    @relation("DefaultCoach")
  weeklyQuotas      CoachWeeklyQuota[]
  submissions       ClassSubmission[]
  unavailabilities  Unavailability[]
}

model ClassTemplate {
  id        String   @id @default(cuid())
  dayOfWeek Int // 1 = Monday ... 7 = Sunday
  startTime String // "HH:mm"
  endTime   String // "HH:mm"
  label     String
  room      String   @default("Salle 1")
  isPrivate Boolean  @default(false)
  active    Boolean  @default(true)
  coachId   String? // default coach applied when a week is generated from this slot
  coach     Coach?   @relation("DefaultCoach", fields: [coachId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())

  instances ClassInstance[]
}

model ClassInstance {
  id                String         @id @default(cuid())
  templateId        String?
  template          ClassTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  date              DateTime // date only (time zeroed), the day this class occurs
  startTime         String // "HH:mm"
  endTime           String // "HH:mm"
  label             String
  room              String         @default("Salle 1")
  isPrivate         Boolean        @default(false)
  // Who's credited with this class. For a still-PLANNED class this is the
  // planning assignment (set by the admin). Once any coach self-reports a
  // DONE class, this is overwritten to whoever reported it — the most
  // recent DONE report always wins, so any coach can reclaim a wrongly
  // claimed class just by reporting it themselves. A MISSED report never
  // changes this — it only ever records who was on the hook, not who's
  // reporting.
  coachId           String?
  coach             Coach?         @relation("PrimaryCoach", fields: [coachId], references: [id], onDelete: SetNull)
  // Reserved for the admin's proactive "find a substitute for this missed
  // class" workflow (assignSubstitute) — unrelated to coach self-reporting.
  substituteCoachId String?
  substituteCoach   Coach?         @relation("SubstituteCoach", fields: [substituteCoachId], references: [id], onDelete: SetNull)
  status            String         @default("PLANNED") // "PLANNED" | "DONE" | "MISSED" | "CANCELLED"
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  submissions ClassSubmission[]

  @@index([date])
  @@index([coachId])
  @@index([substituteCoachId])
}

model CoachWeeklyQuota {
  id         String   @id @default(cuid())
  coachId    String
  coach      Coach    @relation(fields: [coachId], references: [id], onDelete: Cascade)
  weekStart  DateTime // Monday 00:00 of the target week
  maxLessons Int

  @@unique([coachId, weekStart])
}

// Marks a week's planning as validated by the admin. The row's mere
// existence means "locked" — once present, coaches can no longer submit or
// change self-reports for that week from My Classes (see
// src/lib/planning-lock.ts). The admin's own Planning page is unaffected;
// deleting the row (via the Unlock action) re-opens the week.
model PlanningWeek {
  id          String   @id @default(cuid())
  weekStart   DateTime @unique // Monday 00:00 of the validated week
  validatedAt DateTime @default(now())
}

// A coach's self-report that they taught (or missed) a given class. Any
// coach can submit for any class in the week's planning, not just the one
// it's assigned to — this is what lets two coaches independently claim the
// same class so a false claim can always be corrected: either coach can
// clear their own submission, and the most recently updated submission is
// always what's reflected on the class (see ClassInstance.coachId).
model ClassSubmission {
  id              String        @id @default(cuid())
  classInstanceId String
  classInstance   ClassInstance @relation(fields: [classInstanceId], references: [id], onDelete: Cascade)
  coachId         String
  coach           Coach         @relation(fields: [coachId], references: [id], onDelete: Cascade)
  status          String // "DONE" | "MISSED"
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@unique([classInstanceId, coachId])
  @@index([classInstanceId])
}

// A specific calendar day the box is shut (holiday, etc.), set by the admin
// from Planning. generateWeek skips templates that would land on a closed
// date, and closeDay cancels any already-scheduled PLANNED classes on it —
// reopenDay reverses both (see lib/actions/planning.ts). Mirrors resetWeek's
// "only touch PLANNED, leave resolved records alone" precedent.
model BoxClosure {
  id        String   @id @default(cuid())
  date      DateTime @unique // date only
  note      String?
  createdAt DateTime @default(now())
}

// A coach self-flagging that they won't be able to coach during a date
// range (vacation, injury, etc.) — purely informational, doesn't touch
// Planning or ClassInstance assignments on its own. Submitting one notifies
// the admin immediately (onsite banner + email); acknowledgedAt is set once
// the admin has seen it, which drops it off that banner.
//
// When recurring is true, this instead marks a standing weekly time off
// (e.g. "every Monday, permanently") — startDate anchors the day-of-week
// and endDate is set equal to startDate (there's no end), and matching
// logic elsewhere checks the weekday instead of a date range.
model Unavailability {
  id             String    @id @default(cuid())
  coachId        String
  coach          Coach     @relation(fields: [coachId], references: [id], onDelete: Cascade)
  startDate      DateTime // date only, inclusive
  endDate        DateTime // date only, inclusive
  recurring      Boolean   @default(false)
  note           String?
  createdAt      DateTime  @default(now())
  acknowledgedAt DateTime?

  @@index([coachId])
  @@index([endDate])
}
