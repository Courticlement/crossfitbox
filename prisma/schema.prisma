generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// --- App models ---

// One CrossFit box. Created by a PLATFORM_SUPERADMIN Admin (organizationId
// null — see Admin.role below and lib/actions/organizations.ts). Every
// operational model (Coach, Room, ClassTemplate, ClassInstance,
// PlanningWeek, BoxClosure, ...) lives in this Organization's own Postgres
// schema — see tenantPrisma in lib/prisma.ts — not the shared control-plane
// schema Organization/Admin live in. Those models' organizationId column is
// therefore a plain scalar here, deliberately NOT declared as a Prisma
// @relation: Prisma's relational query features (include, _count, nested
// select) assume a relation's two sides share one schema/connection, which
// isn't true across the control-plane/tenant-schema boundary — attempting
// it fails at runtime with "table does not exist" (Coach/Room aren't
// reachable from the connection Organization queries run on). Admin is the
// one exception below: it stays in the control-plane schema alongside
// Organization, so that relation is real and usable.
model Organization {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())

  admins Admin[]
}

// A room/physical space at a box, used to lane out ClassTemplate/
// ClassInstance on the Planning grid (see WeekGrid) — replaces the old
// hardcoded ROOMS const now that each Organization defines its own. Never
// hard-deleted (see archived) since historical classes reference it.
// organizationId is a plain column, not a Prisma relation — see
// Organization's comment above for why.
model Room {
  id             String @id @default(cuid())
  organizationId String
  name           String
  // Short header abbreviation on the Planning grid (e.g. "S1"); falls back
  // to name when unset.
  shortLabel     String?
  // Hex tint for this room's lane/header chip on the Planning grid; falls
  // back to a neutral tint when unset.
  color          String?
  archived       Boolean      @default(false)
  createdAt      DateTime     @default(now())

  templates ClassTemplate[]
  instances ClassInstance[]

  @@unique([organizationId, name])
}

// A person with a login to /admin. Replaces the old single shared
// ADMIN_PASSWORD gate so access can be granted or revoked per person — a
// SUPERADMIN can additionally manage other Admin accounts within their own
// Organization (see lib/actions/admins.ts and /admin/admins), while a plain
// ADMIN has the same access to the rest of /admin (including managing
// coaches) as before. A PLATFORM_SUPERADMIN sits outside every Organization
// (organizationId null) and only manages the list of Organizations itself
// (see lib/actions/organizations.ts and /superadmin) — see auth-context.ts's
// requireOrgAdmin vs requirePlatformSuperadmin in organizations.ts.
model Admin {
  id             String        @id @default(cuid())
  email          String        @unique
  passwordHash   String
  role           String        @default("ADMIN") // "ADMIN" | "SUPERADMIN" | "PLATFORM_SUPERADMIN"
  organizationId String? // null only for PLATFORM_SUPERADMIN
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  // Soft-delete, mirroring Coach.archived: revokes login without losing the
  // account (e.g. who created it, when) — reversible, unlike deleting it.
  archived       Boolean       @default(false)
  createdAt      DateTime      @default(now())
}

model Coach {
  id                   String @id @default(cuid())
  // Plain column, not a Prisma relation — see Organization's comment above.
  organizationId       String
  name                 String
  level                String? // free-text CrossFit level, e.g. "Level 1"
  // Standard weekly quota of group classes, used on the Dashboard whenever
  // that week has no explicit CoachWeeklyQuota override — lets the admin
  // set it once instead of every week. A week-specific override in
  // CoachWeeklyQuota always wins over this.
  weeklyQuota          Int?
  // € paid per validated group class this coach delivers (see
  // computeCoachStats). Null falls back to the CrossFit-level default (see
  // groupClassRate) — set once the admin edits it on the Coaches page, at
  // which point it's a plain per-coach number and no longer follows level
  // changes automatically.
  rate                 Int?
  // Hex color (e.g. "#3b82f6") tinting this coach's classes on the admin
  // Planning grid, so the head coach can see who's teaching what at a
  // glance — see WeekGrid. Null falls back to the room-based tint. Unique
  // (Postgres allows unlimited NULLs alongside a unique constraint, so this
  // only actually restricts non-null values) so two coaches never end up
  // sharing a color — see renameCoach's takenColors check, which is the
  // primary guard; this is the backstop against a race between two saves.
  // Unique per-organization (Coach.name is too — see @@unique below).
  color                String?
  // Login credential for /upload — the coach's unique `name` doubles as
  // their username. Null until the admin sets one (see setCoachPassword on
  // the Coaches page); a coach with no password set can't log in yet.
  // Replaces the old unguessable-link (accessToken) system now that /upload
  // is gated by real auth (see middleware.ts).
  passwordHash         String?
  // Set when the admin marks this coach's private-class debt as settled
  // (see markPrivateBalancePaid) — only private classes delivered after
  // this date count toward the outstanding balance shown on the Coaches
  // page (see computePrivateBalance). Null means nothing has ever been
  // paid, so the whole history counts.
  privateBalancePaidAt DateTime?
  // Soft-delete: set once a coach no longer works at the box. Keeps their
  // history (past classes, submissions, stats) intact while cutting off
  // their private upload access (see /upload/[token] and the coach-active
  // guard in lib/actions/submissions.ts) — reversible via unarchiveCoach,
  // unlike Remove which permanently deletes the row.
  archived             Boolean      @default(false)
  createdAt            DateTime     @default(now())

  classInstances    ClassInstance[]    @relation("PrimaryCoach")
  substituteClasses ClassInstance[]    @relation("SubstituteCoach")
  templates         ClassTemplate[]    @relation("DefaultCoach")
  weeklyQuotas      CoachWeeklyQuota[]
  submissions       ClassSubmission[]
  unavailabilities  Unavailability[]
  privatePayments   PrivatePayment[]

  @@unique([organizationId, name])
  @@unique([organizationId, color])
}

// A record of a coach's private-class debt being settled — created by
// markPrivateBalancePaid alongside stamping Coach.privateBalancePaidAt, so
// the running balance can reset to zero while still keeping proof of what
// was paid and when (see the Data page's "Historique des paiements" table).
model PrivatePayment {
  id      String   @id @default(cuid())
  coachId String
  coach   Coach    @relation(fields: [coachId], references: [id], onDelete: Cascade)
  // € settled by this payment — a snapshot of the balance at the moment it
  // was marked paid, not a live computation, so past history stays accurate
  // even as PRIVATE_CLASS_COST_EUR or a coach's classes change later.
  amount  Int
  paidAt  DateTime @default(now())

  @@index([coachId])
  @@index([paidAt])
}

model ClassTemplate {
  id        String   @id @default(cuid())
  dayOfWeek Int // 1 = Monday ... 7 = Sunday
  startTime String // "HH:mm"
  endTime   String // "HH:mm"
  label     String
  roomId    String
  room      Room     @relation(fields: [roomId], references: [id])
  isPrivate Boolean  @default(false)
  active    Boolean  @default(true)
  coachId   String? // default coach applied when a week is generated from this slot
  coach     Coach?   @relation("DefaultCoach", fields: [coachId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())

  instances ClassInstance[]

  @@index([roomId])
}

model ClassInstance {
  id                String         @id @default(cuid())
  templateId        String?
  template          ClassTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  date              DateTime // date only (time zeroed), the day this class occurs
  startTime         String // "HH:mm"
  endTime           String // "HH:mm"
  label             String
  roomId            String
  room              Room           @relation(fields: [roomId], references: [id])
  isPrivate         Boolean        @default(false)
  // A whole-team event (staff meeting, seminar, box party…) rather than a
  // class taught by one coach — created with coachId left null (see
  // addAdHocClass) so it doesn't count toward anyone's quota or pay, and
  // shows up on every coach's My Classes the same way an unassigned class
  // does. Rendered with a much louder treatment than a normal class on both
  // WeekGrid and DayAgenda so it can't be missed.
  isTeamEvent       Boolean        @default(false)
  // Who's credited with this class. For a still-PLANNED class this is the
  // planning assignment (set by the admin). Once any coach self-reports a
  // DONE class, this is overwritten to whoever reported it — the most
  // recent DONE report always wins, so any coach can reclaim a wrongly
  // claimed class just by reporting it themselves. A MISSED report never
  // changes this — it only ever records who was on the hook, not who's
  // reporting.
  coachId           String?
  coach             Coach?         @relation("PrimaryCoach", fields: [coachId], references: [id], onDelete: SetNull)
  // Reserved for the admin's proactive "find a substitute for this missed
  // class" workflow (assignSubstitute) — unrelated to coach self-reporting.
  substituteCoachId String?
  substituteCoach   Coach?         @relation("SubstituteCoach", fields: [substituteCoachId], references: [id], onDelete: SetNull)
  status            String         @default("PLANNED") // "PLANNED" | "DONE" | "MISSED" | "CANCELLED"
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  submissions ClassSubmission[]
  review      ClassReview?

  @@index([date])
  @@index([coachId])
  @@index([substituteCoachId])
  @@index([roomId])
}

// The head coach's structured observation of a delivered class — walks
// through each phase of the session, scores six coaching pillars, and ends
// on one focus area for next time plus an overall color rating. One per
// ClassInstance (see Suivi coaching / /admin/reviews for the history view,
// filterable by coach and date).
model ClassReview {
  id              String        @id @default(cuid())
  classInstanceId String        @unique
  classInstance   ClassInstance @relation(fields: [classInstanceId], references: [id], onDelete: Cascade)

  briefingNotes   String?
  generalWuNotes  String?
  specificWuNotes String?
  skillWodNotes   String?
  coolDownNotes   String?

  // Each pillar is "ok" | "mid" | "bad" — rated on the whole session, not
  // per segment (see the Piliers step of the review wizard).
  pillarEnseignement     String
  pillarObservation      String
  pillarCorrection       String
  pillarGestionGroupe    String
  pillarPresenceAttitude String
  pillarDemonstration    String

  // What the coach recognized themselves during the debrief — optional,
  // since not every review includes a live exchange with the coach.
  identifiedText String?
  // The single focus until the next observation — the one required outcome
  // of a review, so it's always present.
  focusText      String
  // Overall session rating: "green" | "yellow" | "orange" | "red".
  pastille       String

  createdAt DateTime @default(now())

  @@index([createdAt])
}

model CoachWeeklyQuota {
  id         String   @id @default(cuid())
  coachId    String
  coach      Coach    @relation(fields: [coachId], references: [id], onDelete: Cascade)
  weekStart  DateTime // Monday 00:00 of the target week
  maxLessons Int

  @@unique([coachId, weekStart])
}

// Marks a week's planning as validated by the admin. The row's mere
// existence means "locked" — once present, coaches can no longer submit or
// change self-reports for that week from My Classes (see
// src/lib/planning-lock.ts). The admin's own Planning page is unaffected;
// deleting the row (via the Unlock action) re-opens the week.
model PlanningWeek {
  id             String   @id @default(cuid())
  // Plain column, not a Prisma relation — see Organization's comment above.
  organizationId String
  weekStart      DateTime // Monday 00:00 of the validated week
  validatedAt    DateTime @default(now())

  @@unique([organizationId, weekStart])
}

// A coach's self-report that they taught (or missed) a given class. Any
// coach can submit for any class in the week's planning, not just the one
// it's assigned to — this is what lets two coaches independently claim the
// same class so a false claim can always be corrected: either coach can
// clear their own submission, and the most recently updated submission is
// always what's reflected on the class (see ClassInstance.coachId).
model ClassSubmission {
  id              String        @id @default(cuid())
  classInstanceId String
  classInstance   ClassInstance @relation(fields: [classInstanceId], references: [id], onDelete: Cascade)
  coachId         String
  coach           Coach         @relation(fields: [coachId], references: [id], onDelete: Cascade)
  status          String // "DONE" | "MISSED"
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@unique([classInstanceId, coachId])
  @@index([classInstanceId])
}

// A specific calendar day the box is shut (holiday, etc.), set by the admin
// from Planning. generateWeek skips templates that would land on a closed
// date, and closeDay cancels any already-scheduled PLANNED classes on it —
// reopenDay reverses both (see lib/actions/planning.ts). Mirrors resetWeek's
// "only touch PLANNED, leave resolved records alone" precedent.
model BoxClosure {
  id             String   @id @default(cuid())
  // Plain column, not a Prisma relation — see Organization's comment above.
  organizationId String
  date           DateTime // date only
  note           String?
  createdAt      DateTime @default(now())

  @@unique([organizationId, date])
}

// A coach self-flagging that they won't be able to coach during a date
// range (vacation, injury, etc.) — purely informational, doesn't touch
// Planning or ClassInstance assignments on its own. Submitting one notifies
// the admin immediately (onsite banner + email); acknowledgedAt is set once
// the admin has seen it, which drops it off that banner.
//
// When recurring is true, this instead marks a standing weekly time off
// (e.g. "every Monday, permanently") — startDate anchors the day-of-week
// and endDate is set equal to startDate (there's no end), and matching
// logic elsewhere checks the weekday instead of a date range.
model Unavailability {
  id             String    @id @default(cuid())
  coachId        String
  coach          Coach     @relation(fields: [coachId], references: [id], onDelete: Cascade)
  startDate      DateTime // date only, inclusive
  endDate        DateTime // date only, inclusive
  recurring      Boolean   @default(false)
  note           String?
  createdAt      DateTime  @default(now())
  acknowledgedAt DateTime?

  @@index([coachId])
  @@index([endDate])
}
